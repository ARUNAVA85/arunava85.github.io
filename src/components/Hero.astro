---
// Hero Component
// Centered vertical layout: Image on top, then name, email, social icons, and navigation links
---

<section id="hero" class="py-20 md:py-24 flex items-center justify-center">
  <div class="flex flex-col items-center justify-center max-w-md text-center">
    <!-- Profile Picture - Circular with Ring -->
    <div class="mb-8">
      <div class="w-40 h-40 md:w-48 md:h-48 rounded-full ring-4 ring-offset-2 ring-neutral-300 ring-offset-white shadow-lg overflow-hidden">
        <img
          src="/assets/profile.jpg"
          alt="Arunava Nandi"
          class="w-full h-full object-cover"
        />
      </div>
    </div>

    <!-- Name -->
    <h1 class="text-5xl md:text-6xl font-bold tracking-tight text-neutral-900 leading-tight mb-3">
      Arunava Nandi
    </h1>

    <!-- Email (clickable) -->
    <a href="mailto:arunavanandi.official@gmail.com" class="text-base md:text-lg text-neutral-700 hover:text-neutral-900 font-normal mb-8 hover:underline transition-colors duration-300">
      arunavanandi.official@gmail.com
    </a>

    <!-- Social Icons -->
    <div class="flex gap-3 mb-12 justify-center">
      <a
        href="https://github.com/Arunava85"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-8 h-8 text-neutral-700 hover:text-neutral-900 transition-all duration-300 hover:scale-110"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a
        href="https://linkedin.com/in/arunava-nandi-b729a8197"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-8 h-8 text-neutral-700 hover:text-neutral-900 transition-all duration-300 hover:scale-110"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
        </svg>
      </a>
      <a
        href="https://x.com/this_is_Arunava"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-8 h-8 text-neutral-700 hover:text-neutral-900 transition-all duration-300 hover:scale-110"
        aria-label="X (Twitter)"
        title="X (Twitter)"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.64l-5.204-6.801-5.974 6.801h-3.308l7.73-8.835L.424 2.25h6.837l4.713 6.231 5.734-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
      <a
        href="https://medium.com/@arunava08"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center w-8 h-8 text-neutral-700 hover:text-neutral-900 transition-all duration-300 hover:scale-110"
        aria-label="Medium"
        title="Medium"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42c1.87 0 3.38 2.88 3.38 6.42M24 12c0 2.98-.46 5.4-1.03 5.4-.57 0-1.04-2.42-1.04-5.4s.47-5.4 1.04-5.4c.57 0 1.03 2.42 1.03 5.4z"/>
        </svg>
      </a>
    </div>

    <!-- Quick Navigation Links -->
    <div class="flex flex-wrap gap-6 md:gap-8 text-sm md:text-base justify-center">
      <a href="#projects" class="text-neutral-700 hover:text-neutral-900 font-normal transition-colors hover:underline">Projects</a>
      <a href="#skills" class="text-neutral-700 hover:text-neutral-900 font-normal transition-colors hover:underline">Skills</a>
      <a href="#blog" class="text-neutral-700 hover:text-neutral-900 font-normal transition-colors hover:underline">Blog</a>
      <a href="#contact" class="text-neutral-700 hover:text-neutral-900 font-normal transition-colors hover:underline">Contact</a>
    </div>
  </div>
</section>
