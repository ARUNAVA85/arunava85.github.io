---
// BlogPreview Component
// Simple blog post listing - information-first

import { getLatestPosts } from '../data/blogPosts';

const latestPosts = getLatestPosts(5);
---

<section id="blog" class="border-t border-neutral-200 py-12 md:py-16">
  <h2 class="text-2xl md:text-3xl font-bold mb-8 text-neutral-900">Latest Articles</h2>

  <div class="space-y-6 md:space-y-8">
    {
      latestPosts.map((post) => (
        <a
          href={post.mediumUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col md:flex-row gap-4 md:gap-6 border border-neutral-200 rounded-lg p-4 md:p-5 hover:border-blue-300 hover:bg-blue-50/50 hover:shadow-lg transition-all duration-300"
        >
          {/* Cover Image - Square */}
          {post.coverImage && (
            <div class="flex-shrink-0 w-full md:w-32 md:h-32 overflow-hidden rounded-lg bg-neutral-200">
              <img
                src={post.coverImage}
                alt={post.title}
                class="w-full h-24 md:h-32 object-cover group-hover:scale-110 transition-transform duration-300"
              />
            </div>
          )}

          {/* Content */}
          <div class="flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-lg font-semibold text-neutral-900 group-hover:text-blue-600 transition-colors mb-2">
                {post.title}
              </h3>
              <p class="text-sm text-neutral-500 mb-2">
                {new Date(post.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </p>
              <p class="text-neutral-700 mb-3 line-clamp-2">
                {post.excerpt}
              </p>
            </div>

            {/* Tags */}
            <div class="flex flex-wrap gap-2">
              {post.tags.map((tag) => (
                <span class="text-xs px-2 py-1 text-neutral-600 bg-neutral-100 rounded-md">
                  {tag}
                </span>
              ))}
            </div>
          </div>

          {/* Arrow Icon */}
          <div class="flex-shrink-0 flex items-center text-blue-600 group-hover:translate-x-1 transition-transform duration-300">
            <span class="text-lg font-semibold">→</span>
          </div>
        </a>
      ))
    }
  </div>

  <div class="mt-8">
    <a
      href="/blog"
      class="text-blue-600 hover:text-blue-700 hover:underline font-medium"
    >
      View all articles →
    </a>
  </div>
</section>
