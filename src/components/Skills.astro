---
// Skills Component
// Simple list-based skills section - information-first approach

import { skillsData } from '../data/skills';
---

<section id="skills" class="border-t border-neutral-200 py-12 md:py-16">
  <h2 class="text-2xl md:text-3xl font-bold mb-8 text-neutral-900">Skills & Expertise</h2>

  <div class="space-y-8 md:space-y-10">
    {
      skillsData.map((category) => (
        <div>
          <h3 class="text-lg md:text-xl font-semibold text-neutral-900 mb-2">
            {category.name}
          </h3>
          <p class="text-sm md:text-base text-neutral-600 mb-4">
            {category.description}
          </p>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="px-3 py-1 text-sm text-neutral-700 bg-neutral-100">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
