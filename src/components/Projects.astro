---
// Projects Component
// Simple, clean project listing - information-first

import { allProjects } from '../data/projects';
---

<section id="projects" class="border-t border-neutral-200 py-12 md:py-16">
  <h2 class="text-2xl md:text-3xl font-bold mb-8 text-neutral-900">Projects</h2>

  <div class="space-y-8 md:space-y-10">
    {
      allProjects.map((project) => (
        <div class="border-b border-neutral-200 pb-6 md:pb-8">
          <h3 class="text-lg md:text-xl font-semibold text-neutral-900 mb-2">
            {project.title}
          </h3>
          <p class="text-base md:text-lg text-neutral-700 mb-3 leading-relaxed">
            {project.description}
          </p>
          <p class="text-sm md:text-base text-neutral-600 mb-4">
            <span class="font-semibold">Tech:</span> {project.technologies.join(', ')}
          </p>
          <div class="flex flex-wrap gap-4 text-sm md:text-base">
            {
              project.links.github && (
                <a
                  href={project.links.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 hover:text-blue-700 hover:underline"
                >
                  GitHub
                </a>
              )
            }
            {
              project.links.live && (
                <a
                  href={project.links.live}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 hover:text-blue-700 hover:underline"
                >
                  Live Demo
                </a>
              )
            }
            {
              project.links.demo && (
                <a
                  href={project.links.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-blue-600 hover:text-blue-700 hover:underline"
                >
                  Learn More
                </a>
              )
            }
          </div>
        </div>
      ))
    }
  </div>
</section>
