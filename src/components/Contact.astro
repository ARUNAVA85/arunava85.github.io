---
// Contact Component
// Simple contact form with Web3Forms
// No backend - secure, privacy-first approach

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<section id="contact" class="border-t border-neutral-200 py-12 md:py-16 flex justify-center">
  <div class="w-full max-w-md">
    <h2 class="text-2xl md:text-3xl font-bold mb-8 text-neutral-900 text-center">Contact</h2>

    <div class="w-full">
    {
      !web3formsKey ? (
        <div class="p-4 bg-amber-50 border border-amber-200 rounded mb-8">
          <p class="text-sm text-amber-900">
            <strong>Setup needed:</strong> Add your Web3Forms access key to `.env` (see README for instructions)
          </p>
        </div>
      ) : null
    }

    <form
      action="https://api.web3forms.com/submit"
      method="POST"
      class="space-y-4"
    >
      {/* Hidden fields for Web3Forms */}
      <input type="hidden" name="access_key" value={web3formsKey} />
      <input type="hidden" name="bot_field" value="" />
      <input
        type="hidden"
        name="redirect"
        value={`${Astro.url.origin}/?success=true`}
      />

      <!-- Name Field -->
      <div>
        <label for="name" class="block text-sm md:text-base font-medium text-neutral-900 mb-2">
          Name
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          class="w-full px-4 py-2 md:py-3 text-base border border-neutral-300 rounded text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="Your name"
        />
      </div>

      <!-- Email Field -->
      <div>
        <label for="email" class="block text-sm md:text-base font-medium text-neutral-900 mb-2">
          Email
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          class="w-full px-4 py-2 md:py-3 text-base border border-neutral-300 rounded text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="your.email@example.com"
        />
      </div>

      <!-- Subject Field -->
      <div>
        <label for="subject" class="block text-sm md:text-base font-medium text-neutral-900 mb-2">
          Subject
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          class="w-full px-4 py-2 md:py-3 text-base border border-neutral-300 rounded text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500"
          placeholder="What is this about?"
        />
      </div>

      <!-- Message Field -->
      <div>
        <label for="message" class="block text-sm md:text-base font-medium text-neutral-900 mb-2">
          Message
        </label>
        <textarea
          id="message"
          name="message"
          required
          rows={4}
          class="w-full px-4 py-2 md:py-3 text-base border border-neutral-300 rounded text-neutral-900 placeholder-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none"
          placeholder="Your message..."
        ></textarea>
      </div>

      <!-- Submit Button -->
      <div class="flex justify-center pt-2">
        <button
          type="submit"
          class="px-8 py-2 md:py-3 text-base md:text-lg bg-blue-600 text-white font-medium rounded hover:bg-blue-700 transition-colors"
        >
          Send
        </button>
      </div>
    </form>
    </div>
  </div>
</section>
